prometheus:
  prometheusSpec:
    retention: 14d
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: local-path
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 10Gi
    resources:
      requests:
        cpu: 150m
        memory: 500Mi
      limits:
        cpu: 1000m
        memory: 1.5Gi
grafana:
  adminPassword: {{ grafana_admin_password | ansible.builtin.to_json }}
  persistence:
    enabled: true
    storageClassName: local-path
    size: 5Gi
  grafana.ini:
    server:
      root_url: "%(protocol)s://%(domain)s:%(http_port)s/"
      serve_from_sub_path: false
    live:
      allowed_origins: "*"
prometheus-node-exporter:
  enabled: true
kube-state-metrics:
  enabled: true
metrics-server:
  enabled: true
  args:
    - --kubelet-insecure-tls

