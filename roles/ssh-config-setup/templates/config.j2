# Managed by Ansible - ssh-config-setup role
# Do not edit manually

{% for host_name, host_data in (ssh_hosts | default({})).items() %}
{% if host_data is mapping %}
{% set host_address = (host_data.hostname | default(host_data.ip | default(''), true)) | default('', true) | string | trim %}
{% set host_cloud = host_data.cloud | default(ssh_config_cloud) %}
{% else %}
{% set host_address = host_data | default('', true) | string | trim %}
{% set host_cloud = ssh_config_cloud %}
{% endif %}
{% if host_cloud == 'aws' %}
{% set provider_user = ssh_config_aws_user %}
{% set provider_identity = ssh_config_aws_identity_file %}
{% else %}
{% set provider_user = ssh_config_gcp_user %}
{% set provider_identity = ssh_config_gcp_identity_file %}
{% endif %}
{% if host_data is mapping %}
{% set ssh_user = host_data.user | default(provider_user) %}
{% set ssh_identity = host_data.identity_file | default(provider_identity) %}
{% else %}
{% set ssh_user = provider_user %}
{% set ssh_identity = provider_identity %}
{% endif %}
{% if host_address %}
Host {{ host_name }}
    HostName {{ host_address }}
    User {{ ssh_user }}
    IdentityFile {{ ssh_identity }}
    IdentitiesOnly {{ ssh_config_identities_only | default('yes') }}
    StrictHostKeyChecking {{ ssh_config_strict_host_key_checking | default('no') }}
    UserKnownHostsFile {{ ssh_known_hosts_file }}

{% endif %}
{% endfor %}
{% for custom_host in (ssh_config_custom_hosts | default([])) %}
Host {{ custom_host.name }}
{% if custom_host.hostname | default('', true) | string | trim %}
  HostName {{ custom_host.hostname }}
{% endif %}
{% if custom_host.user is defined %}
  User {{ custom_host.user }}
{% endif %}
{% if custom_host.identity_file is defined %}
  IdentityFile {{ custom_host.identity_file }}
{% endif %}
{% if custom_host.identities_only is defined %}
  IdentitiesOnly {{ custom_host.identities_only }}
{% endif %}
{% if custom_host.add_keys_to_agent is defined %}
  AddKeysToAgent {{ custom_host.add_keys_to_agent }}
{% endif %}
{% if custom_host.use_keychain is defined %}
  UseKeychain {{ custom_host.use_keychain }}
{% endif %}
{% if custom_host.extra_options is defined %}
{% for opt_key, opt_val in custom_host.extra_options.items() %}
  {{ opt_key }} {{ opt_val }}
{% endfor %}
{% endif %}

{% endfor %}
