---
# Trust anchor: self-signed root CA, long-lived, manually rotated
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: linkerd-trust-anchor
  namespace: {{ linkerd_namespace }}
spec:
  isCA: true
  commonName: root.linkerd.cluster.local
  secretName: linkerd-identity-trust-roots
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    name: {{ linkerd_cert_manager_cluster_issuer }}
    kind: ClusterIssuer
    group: cert-manager.io
  duration: {{ linkerd_trust_anchor_duration }}
  renewBefore: {{ linkerd_trust_anchor_renew_before }}
---
# Namespace-scoped Issuer backed by the trust anchor
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: linkerd-trust-anchor
  namespace: {{ linkerd_namespace }}
spec:
  ca:
    secretName: linkerd-identity-trust-roots
---
# Issuer certificate: short-lived, auto-rotated by cert-manager
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: linkerd-identity-issuer
  namespace: {{ linkerd_namespace }}
spec:
  isCA: true
  commonName: identity.linkerd.cluster.local
  secretName: linkerd-identity-issuer
  privateKey:
    algorithm: ECDSA
    size: 256
  issuerRef:
    name: linkerd-trust-anchor
    kind: Issuer
    group: cert-manager.io
  duration: {{ linkerd_issuer_duration }}
  renewBefore: {{ linkerd_issuer_renew_before }}
